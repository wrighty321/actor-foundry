# Copy this file to `.env.local`, fill in real values there, and NEVER commit `.env.local`.
# This file (.env.example) carries key NAMES only — no values — and is safe to commit.
#
# The split below is the whole game (red-team surfaces 01 & 02):
#   - Server-only secrets must never reach the browser. Do NOT prefix them NEXT_PUBLIC_,
#     do NOT import them into anything under /app, /pages, /src/components, or /public.
#   - Only the "public by design" block is safe client-side.

# --- Server-only secrets (browser must never see these) ---
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Public by design (safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
