CLAUDE.local.md
.claude/settings.local.json

# Editor/OS cruft
.DS_Store
Thumbs.db

# Secrets — never commit. .env.example stays tracked (names only, no values).
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json

# Obsidian per-machine config (the wiki/ folder is opened as an Obsidian vault)
.obsidian/

# OS interim run state (briefs, receipts, leases) — never committed (ADR 016)
.os/runs/
