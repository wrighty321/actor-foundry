{
  "permissions": {
    "allow": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const d=JSON.parse(require('fs').readFileSync(0,'utf8')); const p=(d.tool_input&&d.tool_input.file_path)||''; process.exit(p.includes('.env')?2:0);\""
          }
        ]
      }
    ]
  }
}
