{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ct.foundry.gap-shortlist@1.schema.json",
  "title": "Gap shortlist — reader to scout, wf.foundry.target-research",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshot", "gaps"],
  "properties": {
    "snapshot": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "gaps": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["site", "use_case", "evidence_ref", "incumbent", "saturation_count", "titles_counted", "why_gap"],
        "properties": {
          "site": { "type": "string", "pattern": "^https://" },
          "use_case": { "type": "string", "maxLength": 200 },
          "evidence_ref": { "type": "string", "description": "store-gaps row id or snapshot actor id" },
          "incumbent": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["actor_id", "users_30d", "success_rate", "rating", "notice", "price_free_tier"],
            "properties": {
              "actor_id": { "type": "string" },
              "users_30d": { "type": "integer", "minimum": 0 },
              "success_rate": { "type": "number", "minimum": 0, "maximum": 1 },
              "rating": { "type": ["number", "null"], "minimum": 0, "maximum": 5 },
              "notice": { "enum": ["NONE", "RESIDENTIAL_PROXY_REQUIRED", "UNDER_MAINTENANCE", null] },
              "price_free_tier": { "type": ["string", "null"] }
            }
          },
          "saturation_count": { "type": "integer", "minimum": 0 },
          "titles_counted": { "type": "array", "items": { "type": "string" } },
          "why_gap": { "enum": ["no actor", "failing actor", "proxy-walled actor", "under maintenance", "deprecated incumbent", "falling users"] }
        }
      }
    }
  }
}
